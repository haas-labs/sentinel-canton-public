# sentinel-canton runtime config. Copy to .env (gitignored); defaults target a local Canton node.
# Variables already set in the environment take precedence over this file.

# Detector to run: stakeholder_anomaly | informee_anomaly | topology_drift | reassignment_limbo | capability_drift
CANTON_DETECTOR=stakeholder_anomaly
# kafka = consume CANTON_TX_TOPIC; fs = replay CANTON_INPUT_PATH
CANTON_INPUT=kafka

# Kafka/Redpanda bootstrap servers
CANTON_KAFKA_BOOTSTRAP=localhost:19092
# Input stream produced by the trunk-canton adapter
CANTON_TX_TOPIC=canton.localnet.tx
# Output alert topic
CANTON_EVENTS_TOPIC=canton.localnet.events
# Consumer group; empty = sentinel-canton-<detector>
CANTON_CONSUMER_GROUP=

# Participant Admin API (host:port, gRPC) for capability_drift; needs the [admin] extra. Empty = disabled.
CANTON_ADMIN_API_URL=localhost:5012

# JSON of detector parameters; empty = defaults. An admin_api_url here overrides CANTON_ADMIN_API_URL.
CANTON_PARAMETERS=
# Directory for stateful detectors' state files; empty = no persistence.
# reassignment_limbo (and topology_drift) need it set to a directory that survives restarts. Without
# it, a restart forgets every open reassignment, so a contract frozen across the restart is never
# reported. With it, stop the process with SIGTERM or Ctrl-C (SIGINT), not SIGKILL: a clean stop writes
# the pending state first. Otherwise an assign seen just before the stop can be missing from the file,
# and the restarted detector raises a false limbo alert for a contract that already arrived.
CANTON_STATE_DIR=
# fs mode only: a .jsonl file or directory of fixtures
CANTON_INPUT_PATH=
